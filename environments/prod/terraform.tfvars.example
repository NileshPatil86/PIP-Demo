# Copy to terraform.tfvars for local runs, or set the equivalent as GitHub Actions
# repository/environment variables (TF_VAR_* prefixed) consumed by the workflows.

subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"
location        = "centralindia"
name_prefix     = "pipdemo-prod"

# Entra ID group(s) that get cluster-admin via Azure RBAC for Kubernetes Authorization.
aad_admin_group_object_ids = [
  "00000000-0000-0000-0000-000000000000",
]

# Lock the public API server down to trusted source IPs (office/VPN egress,
# self-hosted runner, etc.). Required - the cluster has no allow-all default.
api_server_authorized_ip_ranges = [
  "203.0.113.4/32",
]

kubernetes_version = null # e.g. "1.30" to pin a specific version

system_node_pool_vm_size   = "Standard_D4s_v5"
system_node_pool_min_count = 3
system_node_pool_max_count = 5

user_node_pool_vm_size   = "Standard_D4s_v5"
user_node_pool_min_count = 3
user_node_pool_max_count = 10

acr_sku                      = "Premium"
log_analytics_retention_days = 90
